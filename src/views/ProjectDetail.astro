---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  fallback: boolean;
}

const { lang, project, fallback } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, summary, date, category, tags, github, demo } = project.data;
---

<Base lang={lang} title={title} description={summary} reading>
  <header class="page-head">
    <p class="crumb"><a href={localizePath('/projects/', lang)}>~/projects</a>/{category}/</p>
    <h1>./{title}</h1>
    <p class="lead">{summary}</p>
    <div class="row">
      <span>{date.toISOString().slice(0, 7)}</span>
      <div class="tags">{tags.map((tag) => <span>{tag}</span>)}</div>
      {github && <a href={github} target="_blank" rel="noopener">github ↗</a>}
      {demo && <a href={demo} target="_blank" rel="noopener">demo ↗</a>}
    </div>
  </header>
  {fallback && <p class="fallback"># {t('fallback.notice')}</p>}
  <article class="prose">
    <Content />
  </article>
</Base>

<style>
  .crumb { font-size: 13px; }
  .row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 16px; font-size: 13px; color: var(--dim); }
  .fallback { margin-top: 24px; color: var(--amber); font-size: 13px; }
  article { padding-top: 40px; }
</style>
